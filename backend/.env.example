# Copy to .env and adjust. All fields are optional — the app runs without a .env.

# Runtime
ENVIRONMENT=local
DEBUG=true
ENABLE_DOCS=true
LOG_LEVEL=INFO
LOG_JSON=false

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# AI Providers
GEMINI_API_KEY=

# Cloudinary (optional — persistent storage for uploaded documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Snowflake Settings (optional — persistent analytics and session logging)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

